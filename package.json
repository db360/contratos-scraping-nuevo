{
  "name": "contratos-scraping-nuevo",
  "version": "1.0.0",
  "description": "Scraping + API + frontend para contratos y licitaciones",
  "main": "licitaciones.js",
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "start:api": "npm --prefix apps/api run start",
    "install:apps": "npm --prefix apps/api install && npm --prefix apps/web install",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "legacy:licitaciones": "node licitaciones.js",
    "legacy:contratos": "node contratos_menores.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "csv-parser": "^3.0.0",
    "mysql2": "^3.11.0",
    "puppeteer": "^22.15.0",
    "puppeteer-table-parser": "^1.7.0",
    "fs": "^0.0.1-security"
  }
}
